# Get a free key at https://goal-api.com/signup (free tier, no card).
GOAL_API_KEY=your_api_key_here
# Base URL (default shown; docs also expose https://goal-api.com/api/v1).
GOAL_API_BASE=https://api.goal-api.com/v1

# OPTIONAL — standings source. Botola standings come from SofaScore, which is
# behind Cloudflare and rejects server-side requests. Route it through a
# Cloudflare-solving proxy by setting a URL template containing {url}. When unset
# (or when the proxy fails), standings fall back to the GOAL API automatically.
# Example (ScraperAPI, needs a plan with residential/ultra_premium proxies):
# STANDINGS_PROXY=https://api.scraperapi.com/?api_key=YOUR_KEY&ultra_premium=true&url={url}
STANDINGS_PROXY=
