# Get a free key at https://goal-api.com/signup (free tier, no card).
GOAL_API_KEY=your_api_key_here
# Base URL (default shown; docs also expose https://goal-api.com/api/v1).
GOAL_API_BASE=https://api.goal-api.com/v1
# Standings are pulled from the public 365scores API (no key / proxy needed);
# the GOAL API above is only the automatic fallback if 365scores is unreachable.

# OPTIONAL — social-post title suggestions on the News page.
# Without it the News pages still work; only the "توليد عناوين" button is off.
# Get a key at https://console.anthropic.com/ (server-side only, never shipped
# to the browser). Uses Claude Haiku — a few hundredths of a cent per click.
ANTHROPIC_API_KEY=
